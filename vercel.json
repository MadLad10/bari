{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules/**,dist/**,src/**,public/**,docs/**,eval/**,.git/**,backend/tests/**,backend/seed_data/**,backend/alembic/**,backend/scripts/**,backend/uploads/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/uploads/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/|uploads/).*)", "destination": "/index.html" }
  ]
}
