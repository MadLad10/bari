# Copy to .env and fill in. Never commit .env.
ENV=dev

# docker-compose sets DATABASE_URL for the backend container. This value is for running tools on the host.
DATABASE_URL=postgresql+psycopg://bari:bari@localhost:5433/bari

# Auth: set a long random value, e.g. `python3 -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=


# LLM provider: api (OpenAI-compatible; Groq by default) | ollama (local)
LLM_PROVIDER=api
LLM_API_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_API_MODEL=llama-3.3-70b-versatile
OLLAMA_MODEL=qwen2.5:7b-instruct

# Retrieval
EMBEDDING_MODEL=bge-m3
RERANKER=bge            # bge | none
RERANK_TOP=10
